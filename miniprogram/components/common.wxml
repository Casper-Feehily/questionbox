<template name="header">
  <view class="header"><view class="brand"><text>QUESTIONBOX</text><text class="brand-mark">?</text></view>
    <view class="theme-control" aria-label="外观主题">
      <button size="mini" class="theme-option {{themeIndex === 1 ? 'selected' : ''}}" data-preference="light" bindtap="changeTheme" aria-label="明亮" aria-pressed="{{themeIndex === 1}}"><text>☼</text></button>
      <button size="mini" class="theme-option {{themeIndex === 2 ? 'selected' : ''}}" data-preference="dark" bindtap="changeTheme" aria-label="黑暗" aria-pressed="{{themeIndex === 2}}"><text>☾</text></button>
      <button size="mini" class="theme-option {{themeIndex === 0 ? 'selected' : ''}}" data-preference="system" bindtap="changeTheme" aria-label="跟随系统" aria-pressed="{{themeIndex === 0}}"><text class="system-icon">▣</text></button>
    </view>
  </view>
  <view wx:if="{{demo}}" class="demo-banner">演示模式 · 数据仅存在本机，不会发送提问、邮件或微信通知</view>
</template>
<template name="footer"><view class="footer"><text>慢慢提问，认真回答。✳</text><text class="link" bindtap="openPrivacy">隐私与规则 ↗</text></view></template>
