.reader-screen { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding-top: 12rpx; padding-bottom: max(16rpx, env(safe-area-inset-bottom)); }
.reader-screen .header { flex-shrink: 0; padding-bottom: 18rpx; }
.reader-screen .demo-banner { flex-shrink: 0; margin-top: 14rpx; padding: 10rpx 14rpx; }
.reader-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0 6rpx; color: var(--muted); font-size: 22rpx; flex-shrink: 0; }
.reader-shuffle { padding: 10rpx 0; font-size: 22rpx; background: transparent; color: var(--muted); }
.reader-intro { text-align: center; flex-shrink: 0; padding: 6rpx 0 26rpx; }
.reader-intro .title { margin: 8rpx 0; font-size: 56rpx; }
.reader-intro .hint { font-size: 22rpx; }
.reader-stage { flex: 1; min-height: 0; overflow: hidden; margin: 0 -18rpx; padding: 16rpx 18rpx 120rpx; }
.reader-deck { position: relative; width: 100%; height: 100%; }
.reader-card { position: absolute; inset: 0; border: 3rpx solid var(--line); border-radius: 16rpx; padding: 28rpx 32rpx 18rpx; display: flex; flex-direction: column; background: var(--lavender); color: var(--ink); box-shadow: 8rpx 10rpx 0 var(--shadow); overflow: hidden; transform-origin: center bottom; transition: transform .52s cubic-bezier(.22,1,.36,1), opacity .4s; backface-visibility: hidden; }
.reader-card.tone-green { background: var(--green); }
.reader-card.tone-blue { background: var(--blue); }
.reader-top { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding-bottom: 18rpx; border-bottom: 2rpx solid var(--muted); font-size: 22rpx; color: var(--muted); flex-shrink: 0; }
.reader-top > text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.reader-top > text:last-child { flex-shrink: 0; }
.reader-scroll { flex: 1; height: 0; min-height: 0; margin: 12rpx 0; }
.reader-scroll .question-text { font-family: Georgia, 'Songti SC', serif; font-size: 40rpx; }
.reader-scroll .prose { font-size: 29rpx; }
.reader-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 20rpx; color: var(--muted); padding-top: 14rpx; border-top: 2rpx solid var(--muted); flex-shrink: 0; }
.reader-bottom .link { color: var(--ink); text-decoration: none; padding: 6rpx 0; }
.reader-card.stacked .reader-bottom { visibility: hidden; }
.reader-peek { position: absolute; bottom: 8rpx; left: 32rpx; right: 32rpx; background: inherit; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 20rpx; }
.reader-controls { display: flex; align-items: center; justify-content: center; gap: 36rpx; padding: 12rpx 0; flex-shrink: 0; }
.reader-previous { flex: none; min-width: 0; max-width: 88rpx; width: 88rpx; height: 88rpx; border: 3rpx solid var(--line); border-radius: 50%; color: var(--ink); background: var(--paper); font-size: 42rpx; padding: 8rpx 0; }
.reader-previous[disabled] { color: var(--muted); background: var(--paper); opacity: .5; }
.reader-position { flex: none; display: flex; align-items: baseline; gap: 12rpx; white-space: nowrap; font-family: Georgia, serif; font-size: 48rpx; }
.reader-next { flex: none; width: auto; margin: 0; padding: 18rpx 28rpx; border-radius: 60rpx; font-size: 26rpx; }
.reader-hint { text-align: center; font-size: 20rpx; flex-shrink: 0; }
.is-dragging .reader-card { transition: none; }
.reader-screen .error { flex-shrink: 0; margin: 8rpx 0; padding: 10rpx; font-size: 22rpx; }
.reader-screen .error .button { margin-top: 8rpx; padding: 8rpx; }
@media (max-height: 550px) { .reader-intro { display: none; } .reader-screen .demo-banner { display: none; } .reader-toolbar { padding-top: 4rpx; } .reader-hint { display: none; } }
