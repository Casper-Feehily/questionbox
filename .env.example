# Generate .env with: python3 scripts/configure.py --domain ask.example.com --owner 站长
DEBUG=0
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=ask.example.com
SITE_URL=https://ask.example.com
SITE_DOMAIN=ask.example.com
OWNER_NAME=站长
SITE_TITLE=站长的匿名提问箱
DATA_DIR=/app/data
# Only trust your actual reverse proxy. compose.https.yaml uses the address below.
TRUSTED_PROXY_CIDRS=172.31.250.2/32
# Set to 0 to temporarily allow consecutive questions without time-based quotas.
QUESTION_RATE_LIMIT_ENABLED=1
RATE_COOKIE_MINUTE=1
RATE_COOKIE_HOUR=10
RATE_IP_HOUR=30
RATE_SITE_HOUR=300
# Always: 700 characters per question, 500 questions total (including unpublished).
# Owner's new-question alerts; empty disables them. Keep this secret out of source control.
SERVERCHAN_SENDKEY=
# Reader-only mini program. Keep disabled until a real WeChat account is configured.
WECHAT_ENABLED=0
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_SESSION_DAYS=30
WECHAT_REPLY_TEMPLATE_ID=
# Use the actual approved template fields, e.g. {"thing1":"notice","time2":"time"}.
WECHAT_REPLY_TEMPLATE_FIELDS={}
WECHAT_MINIPROGRAM_STATE=trial
EMAIL_ENABLED=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Outlook / Microsoft 365 uses delegated OAuth2 through Graph instead of SMTP.
# Set EMAIL_BACKEND=box.graph_backend.EmailBackend and EMAIL_ENABLED=1.
# Visitors see the email field only after the owner has connected a mailbox.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_SECRET=
# personal for Outlook/Hotmail; organization for this tenant's Microsoft 365 mailbox.
MS_GRAPH_ACCOUNT_TYPE=personal

# Bark 手机新提问提醒；留空关闭
BARK_DEVICE_KEY=
BARK_SERVER_URL=https://api.day.app
